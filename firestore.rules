rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "anivoxacademy@gmail.com" ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)^anivoxacademy@gmail\\.com$')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validations ---
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (data.email == null || data.email is string) &&
             (data.role == null || data.role in ['student', 'admin']) &&
             (data.age == null || data.age is int) &&
             (data.city == null || data.city is string) &&
             (data.phone == null || data.phone is string) &&
             (data.photoURL == null || data.photoURL is string) &&
             (data.interests == null || (data.interests is string && data.interests.size() <= 1000)) &&
             (data.learningInterests == null || (data.learningInterests is string && data.learningInterests.size() <= 1000)) &&
             (data.profileCompleted == null || data.profileCompleted is bool) &&
             (data.status == null || data.status in ['active', 'blocked', 'suspended']);
    }

    function isValidCourse(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.status in ['Draft', 'Published', 'Archived', 'Coming Soon'];
    }

    function isValidPayment(data) {
      return data.studentId == request.auth.uid &&
             data.courseId is string &&
             data.amount is number && data.amount > 0 &&
             data.utr is string && data.utr.size() <= 60 &&
             (data.status == 'pending' || data.status == 'Pending Verification');
    }

    function isValidEnrollment(data) {
      return data.studentId is string &&
             data.courseId is string &&
             (data.status in ['pending', 'approved', 'rejected'] || data.status is string);
    }

    // --- Match Blocks ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && 
                    isValidUser(incoming()) &&
                    (isAdmin() || (
                      (incoming().role == existing().role || !('role' in incoming().diff(existing()).affectedKeys())) &&
                      (incoming().status == existing().status || !('status' in incoming().diff(existing()).affectedKeys())) &&
                      incoming().diff(existing()).affectedKeys().hasOnly([
                        'uid', 'email', 'displayName', 'age', 'city', 'phone', 'photoURL',
                        'interests', 'learningInterests', 'profileCompleted', 'role', 'status',
                        'createdAt', 'updatedAt'
                      ])
                    ));

      match /progress/{courseId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /courses/{courseId} {
      allow get: if true; // Publicly viewable
      allow list: if true;
      allow create, update: if isAdmin() && isValidCourse(incoming());
      allow delete: if isAdmin();
    }

    match /classes/{classId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /chat/{messageId} {
        allow read, create: if isSignedIn();
      }

      match /hands/{studentId} {
        allow read, write: if isSignedIn();
      }
    }

    match /attendance/{attendanceId} {
      allow read, create, update: if isSignedIn();
    }

    match /payments/{paymentId} {
      allow get: if isOwner(existing().studentId) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && isValidPayment(incoming());
      allow update: if isOwner(existing().studentId) || isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow get: if isOwner(existing().studentId) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && incoming().studentId == request.auth.uid);
      allow update: if isOwner(existing().studentId) || isAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isOwner(existing().recipientId) || isAdmin();
      allow list: if isOwner(resource.data.recipientId) || isAdmin();
      allow create: if isSignedIn();
      allow update: if (isOwner(existing().recipientId) && incoming().diff(existing()).affectedKeys().hasOnly(['read'])) || isAdmin();
    }

    match /portfolios/{projectId} {
      allow get: if resource.data.visibility == 'Public' || isOwner(resource.data.studentId) || isAdmin();
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isOwner(existing().studentId) || isAdmin();
      allow delete: if isOwner(existing().studentId) || isAdmin();
    }

    match /appSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /userCourseAccess/{accessId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); // Allow server/admin actions to log
    }
  }
}
